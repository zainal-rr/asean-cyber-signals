# Supabase (required in production)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Legacy projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
# Server-only. Required by scheduled ingestion and other trusted background work.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me

# Single owner mapping. Create this email/password user only after applying the
# initial migration. Disable Supabase Auth registration and email sign-ups.
OWNER_USERNAME=your-demo-username
OWNER_EMAIL=owner@example.com

# Local development fallback only. This mode is ignored when NODE_ENV=production.
# Generate SESSION_SECRET with: openssl rand -base64 48
DEMO_OWNER_USERNAME=local-owner
DEMO_OWNER_PASSWORD=replace-with-a-local-only-password
SESSION_SECRET=replace-with-at-least-32-random-characters

# Server-only integrations
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
CRON_SECRET=
INGESTION_ADMIN_SECRET=

# Optional monitoring
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
